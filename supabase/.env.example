# Edge Function secrets. Local: copy to supabase/.env.local. Production: `supabase secrets set --env-file ...`
# WORKER_SECRET must equal the Vault secret qals_worker_secret
WORKER_SECRET=local-worker-secret-change-me
OAUTH_STATE_SECRET=change-me-long-random
ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
APP_URL=http://localhost:5180
# Activate cloud connectors when ready (read-only scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Drive Picker (SRS V1.5 FR-GD-001/003): browser API key restricted to the app origins
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
